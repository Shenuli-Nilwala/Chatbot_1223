('AMERICANO', 3.00,'BRAZIL'),
('FLAT WHITE', 3.50, 'INDONISIA'),
('FILTER', 3.00, 'INDIA');

select * from products;

UPDATE products
SET
coffee_origin = 'SRI LANKA'
WHERE
Product_name = 'FILTER';

UPDATE products
SET
PRICE = 3.25,
coffee_origin = 'ITHIOPIA'
WHERE
Product_name = 'AMERICANO';

UPDATE products
SET
coffee_origin = 'COLOMBIA'
WHERE
coffee_origin = 'BRAZIL';
